{
  "npm.autoDetect": "off",
  "npm.packageManager": "bun",
  "npm.exclude": "**/node_modules/**",
  "task.autoDetect": "off",
  "json.schemaDownload.enable": true,
  "json.schemas": [
    {
      "fileMatch": ["**/tsconfig.json", "**/tsconfig.*.json"],
      "url": "./.vscode/schemas/tsconfig.schema.json"
    }
  ]
}
